pkgname=milanium
pkgver=26
pkgrel=6
pkgdesc="ArctineOS system configuration"
arch=('any')
url="https://github.com/ArctineLabs/OS"
license=('GPL3')
depends=('junction' 'base' 'gnome-shell' 'gnome-shell-extension-appindicator' 'gnome-shell-extension-arc-menu' 'gnome-shell-extension-dash-to-panel' 'gnome-shell-extension-desktop-icons-ng' 'networkmanager' 'dracut' 'pkgfile' 'gum' 'zenity')
replaces=('betriebssystem')
provides=('arcli')

package() {
    cp $srcdir/../../airootfs/etc $pkgdir/etc -rv
    cp $srcdir/../../airootfs/usr $pkgdir/usr -rv
    cp $srcdir/../../airootfs/Arctine $pkgdir/Arctine -rv
    rm -rv $pkgdir/Arctine/LiveISO
    rm -rv $pkgdir/etc/passwd
    rm -rv $pkgdir/etc/group
    rm -rv $pkgdir/etc/gshadow
    rm -rv $pkgdir/etc/locale.conf
    rm -rv $pkgdir/etc/localtime
    rm -rv $pkgdir/etc/resolv.conf
    rm -rv $pkgdir/etc/shadow
    rm -rv $pkgdir/etc/hostname
    rm -rv $pkgdir/etc/mkinitcpio.d/linux.preset
    rm -rv $pkgdir/etc/systemd/system/dbus-org.freedesktop.timesync1.service
    rm -rv $pkgdir/etc/systemd/system/sysinit.target.wants/systemd-timesyncd.service
    rm -rv $pkgdir/etc/systemd/system/pacman-init.service
    rm -rv $pkgdir/etc/systemd/system/etc-pacman.d-gnupg.mount
    rm -rv $pkgdir/etc/gdm/*
    rm -rv $pkgdir/etc/sudoers.d/*

    chmod +x -v $pkgdir/Arctine/Scripts/*
    chmod +x -v $pkgdir/Arctine/Tools/ArCLI/Executables/arcli
    chmod +x -v $pkgdir/Arctine/Tools/Arctualiza/arctualiza
    chmod +x -v $pkgdir/Arctine/Tools/ZenityAskpass/zenityaskpass

    ln -sf $pkgdir/Arctine/Tools/ArCLI/Executables/arcli /usr/bin/arcli
    ln -s $pkgdir/Arctine/Tools/Arctualiza/arctualiza /usr/bin/arctualiza
    ln -s $pkgdir/Arctine/Tools/ZenityAskpass/zenityaskpass /usr/bin/zenityaskpass
}
