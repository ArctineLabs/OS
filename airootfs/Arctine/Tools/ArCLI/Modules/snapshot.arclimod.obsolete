#!/usr/bin/bash

if [[ -z ${SnapperConfig:-} ]]; then
    export SnapperConfig="root"
fi

# Load locales.
# Delete this line if you're intending on only using one language for your module.
# The recommended path for module translation files are usually /Arctine/Library/Translations/ArCLI/Modules/,
# but you are free to put it anywhere, as long as the module can access that path.
#case $LANG in
#    C*)
#        # shellcheck disable=SC1091
#        source ../../../Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find debug locale"
#    ;;
#    *)
#        # shellcheck disable=SC1091
#        source /Arctine/Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find the locale file en.arctinelocale in /Arctine/Library/Translations/ArCLI/Executable/."
#    ;;
#esac

# Project details (must be after loading locales and before anything else)
arclimod_Name="Snapshot Module for ArCLI"
arclimod_Author="Arctine Laboratories"
arclimod_Version=1.0
arclimod_Desc="The Snapshot module is an ArCLI wrapper module for Snapper."
arclimod_ShortDesc="Manage snapshots through ArCLI."
arclimod_Year="2026"

# Handle arguments here.
main() {
    case "$1" in
        "-v"|"--version"|"about")
            about
        ;;
        "-h"|"--help"|"help")
            help
        ;;
        "qnew"|"-N"|"--new")
            snapshot.create "$@"
        ;;
        "prepost"|"-Np"|"--pre-post")
            snapshot.create.prepost "${@:2}"
        ;;
        *)
            echo "[!] Invalid subcommand $1."
        ;;
    esac
}

# Show available commands here.
help() {
    # shellcheck disable=SC2154
    echo "Snapshot Module - ArctineOS CLI Tool

snapshot help|-h · display this message
snapshot about|-v|--version · show about
snapshot qnew|-N|--new \"<description>\" · make a quick new snapshot (double quote description!!)
snapshot prepost|-Np|--pre-post <cmd> · automatically create pre and post snapshot while invoking command

\$SnapperConfig is set to: $SnapperConfig
To specify any other config, change the variable's value before running this module"
}

snapshot.create() {
    echo "[i] Creating snapshot with arguments \"$*\"..."
    snapper -c "$SnapperConfig" create --description "$@" || echo "[!] Command failed for some reason."
}

snapshot.create.prepost() {
    echo "[i] Automatically creating pre/post snapshots while invoking command ${*}"
    snapper -c "$SnapperConfig" create --command "${@}" || echo "[!] Command failed for some reason."
}

# Show info about software
about() {
    echo "$arclimod_Name ($arclimod_ShortDesc) $arclimod_Version
$arclimod_Author $arclimod_Year"
    echo "$arclimod_Desc"
}

main "$@"