#!/usr/bin/bash

# Load locales.
# Delete this line if you're intending on only using one language for your module.
# The recommended path for module translation files are usually /Arctine/Library/Translations/ArCLI/Modules/,
# but you are free to put it anywhere, as long as the module can access that path.
#case $LANG in
#    C*)
#        # shellcheck disable=SC1091
#        source ../../../Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find debug locale"
#    ;;
#    *)
#        # shellcheck disable=SC1091
#        source /Arctine/Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find the locale file en.arctinelocale in /Arctine/Library/Translations/ArCLI/Executable/."
#    ;;
#esac

# Project details (must be after loading locales and before anything else)
arclimod_Name="PM Module"
arclimod_Author="Arctine Laboratories"
arclimod_Version=2.0
arclimod_Desc="The PM Module takes input and automatically detects the package manager to install it with. Supports Homebrew, Flatpak and ArCLI modules."
arclimod_ShortDesc="Install packages and modules automatically, upgrade the system."
arclimod_Year="2026"

# Handle arguments here.
main() {
    case "$1" in
        "-v"|"--version"|"about")
            about
        ;;
        "-h"|"--help"|"help")
            help
        ;;
        +*)
            pm.add "$@"
        ;;
        -*)
            pm.subtract "$@"
        ;;
        sysupdate)
            FUNC=$(declare -f pm.sysupdate)
            FUNC2=$(declare -f pm.sysupdate.error)
            sudo bash -c "$FUNC; $FUNC2; pm.sysupdate"
        ;;
        *)
            echo "[!] Invalid subcommand $1."
        ;;
    esac
}

# Show available commands here.
help() {
    # shellcheck disable=SC2154
    echo "PM Module - ArctineOS CLI Tool

pm help · display this message
pm about · show about
pm + <pkg> · automatically install package or module (one at a time)
    -> +A · assume yes on first corresponding package manager
    -> +y · tell package manager to assume yes without confirmation
pm - <pkg> · automatically remove package or module (one at a time)
    -> -A · assume yes on first corresponding package manager
    -> -y · tell package manager to assume yes without confirmation
pm sysupdate · Update ArctineOS"
}

pm.add() {
    BackendArgs=()
    Args=$1

    export Args
    pm.backenddetector "${@:2}"
    pm.argumentassembly
    case "$Backend" in
        localbrew)
            brew install "${BackendArgs[@]}" "${@:2}"
        ;;
        brew)
            # shellcheck disable=SC2046
            # shellcheck disable=SC2068
            brew install "${BackendArgs[@]}" $(brew search "$2" | xargs -n 1 | gum filter --no-limit --select-if-one | xargs)
        ;;
        flatpak|flatpakfile)
            # shellcheck disable=SC2068
            flatpak install ${BackendArgs[@]} ${@:2}
        ;;
        arclimod)
            pm.arclimod "${@}"
        ;;
    esac
}

pm.subtract() {
    BackendArgs=()
    Args=$1

    export Args
    pm.backenddetector "${@:2}"
    pm.argumentassembly
    case "$Backend" in
        localbrew|brew)
            # shellcheck disable=SC2046
            # shellcheck disable=SC2068
            brew uninstall ${BackendArgs[@]} $(brew list | grep "$2" | gum filter --no-limit --select-if-one | xargs)
        ;;
        flatpak|flatpakfile)
            # shellcheck disable=SC2068
            flatpak uninstall ${BackendArgs[@]} ${@:2}
        ;;
        arclimod)
            pm.arclimod "${@}"
        ;;
    esac
}

pm.sysupdate() {
    sudo bootc upgrade
}

pm.sysupdate.error() {
    echo "[!] System update failed with following message: $1"
    exit 1
}

pm.arclimod() {
    case "$Args" in
        +*)
            if [[ $Args == *y* ]]; then
                echo "[i] Installing ArCLI module $2..."
                # shellcheck disable=SC2154
                sudo cp "$2" "$ArCLI_DIR"/Modules/ -v || (echo "[!] Failed." && exit 1)
            else
                read -rp "[i] Install ArCLI module $2? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        sudo cp "$2" "$ArCLI_DIR"/Modules/ -v || (echo "[!] Failed." && exit 1)
                    ;;
                    *)
                        echo "[i] Aborted."
                        return 1
                    ;;
                esac
            fi
        ;;
        -*)
            read -rp "[?] Really remove ArCLI module $2? [Y/n] " confirm
            case "$confirm" in
                Y|y|yes|Yes|YES)
                    sudo rm "$ArCLI_DIR"/Modules/"$2" -v || (echo "[!] Failed." && exit 1)
                ;;
                *)
                    echo "[i] Aborted."
                    return 1
                ;;
            esac
        ;;
        *)
            echo "[!] Unrecognised option for pm.arclimod: $1"
            exit 1
        ;;
    esac
}

pm.backenddetector() {
    if [[ -z "$*" ]]; then
        echo "Please specify a package after pm $Args."
        exit 1
    elif [[ -z $Backend ]]; then
        # If file
        if [[ -f $1 ]]; then
            # If localbrew
            if echo "$1" | grep ".rb$"; then
                GuessBackend=localbrew
                pm.backenddetector.question && return 0
            else
                echo "[W] Local brew guess incorrect"
            fi

            # If flatpakref
            if (echo "$1" | grep ".flatpakref$") || (echo "$1" | grep ".flatpak$"); then
                GuessBackend=flatpakfile 
                pm.backenddetector.question && return 0
            else
                echo "[W] Flatpak (file) guess incorrect"
            fi

            # If ArCLIModule
            if echo "$1" | grep ".arclimod$"; then
                GuessBackend=arclimod 
                pm.backenddetector.question && return 0
            else
                echo "[W] ArCLI Module guess incorrect"
            fi
        fi

        # If not a file
        if brew search "$1" | xargs -n 1 | grep "$1">/dev/null; then
            GuessBackend=brew 
            if pm.backenddetector.question; then 
                return 0
            else
                read -rp "[W] Attempt installation with Flatpak? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        Backend=flatpak
                        export Backend
                    ;;
                    *)
                        echo "[!] User denied."
                        exit 1
                    ;;
                esac
            fi
        else
            read -rp "[W] homebrew guess incorrect. Trying flatpak next, OK? [Y/n] " confirm
            case "$confirm" in
                Y|y|yes|Yes|YES)
                    Backend=flatpak
                    export Backend
                ;;
                *)
                    echo "[!] User denied."
                    exit 1
                ;;
            esac
        fi
    fi
}

pm.backenddetector.question() {
    if [[ $Args == *A* ]]; then
        echo "[i] Automatically selected $GuessBackend"
        Backend=$GuessBackend
        export Backend
    else
        echo "Detected backend: $GuessBackend"
        read -rp "Proceed? [Y/n] " confirm
        case "$confirm" in
            Y|y|yes|Yes|YES)
                Backend=$GuessBackend
                export Backend
                return 0
            ;;
            *)
                echo "[i] Continuing guess..."
                return 1
            ;;
        esac
    fi
}

pm.argumentassembly() {
    case "$Backend" in
        localbrew|brew)
            [[ $Args == *y* ]] && BackendArgs+=(--yes)
            [[ $Args == *v* ]] && BackendArgs+=(--verbose)
            echo "[i] Assembled pm arguments into $Backend ones: ${BackendArgs[*]}"
        ;;

        flatpak|flatpakfile)
            [[ $Args == *y* ]] && BackendArgs+=(--assumeyes)
            [[ $Args == *v* ]] && BackendArgs+=(--verbose)
            echo "[i] Assembled pm arguments into $Backend ones: ${BackendArgs[*]}"
        ;;
    esac
}

# Show info about software
about() {
    echo "$arclimod_Name ($arclimod_ShortDesc) $arclimod_Version
$arclimod_Author $arclimod_Year"
    echo "$arclimod_Desc"
}

main "$@"
