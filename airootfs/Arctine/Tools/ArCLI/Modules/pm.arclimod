#!/usr/bin/bash

# Load locales.
# Delete this line if you're intending on only using one language for your module.
# The recommended path for module translation files are usually /Arctine/Library/Translations/ArCLI/Modules/,
# but you are free to put it anywhere, as long as the module can access that path.
#case $LANG in
#    C*)
#        # shellcheck disable=SC1091
#        source ../../../Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find debug locale"
#    ;;
#    *)
#        # shellcheck disable=SC1091
#        source /Arctine/Library/Translations/ArCLI/Modules/Example/en.arctinelocale || echo "[!] Could not find the locale file en.arctinelocale in /Arctine/Library/Translations/ArCLI/Executable/."
#    ;;
#esac

# Project details (must be after loading locales and before anything else)
arclimod_Name="PM Module"
arclimod_Author="Arctine Laboratories"
arclimod_Version=1.0
arclimod_Desc="The PM Module takes input and automatically detects the package manager to install it with. Supports pacman, Flatpak and ArCLI modules."
arclimod_ShortDesc="Install packages and modules automatically, upgrade the system."
arclimod_Year="2026"

# Handle arguments here.
main() {
    case "$1" in
        "-v"|"--version"|"about")
            about
        ;;
        "-h"|"--help"|"help")
            help
        ;;
        +*)
            pm.add "$@"
        ;;
        -*)
            pm.subtract "$@"
        ;;
        sysupdate)
            pm.sysupdate
        ;;
        *)
            echo "[!] Invalid subcommand $1."
        ;;
    esac
}

# Show available commands here.
help() {
    # shellcheck disable=SC2154
    echo "PM Module - ArctineOS CLI Tool

pm help · display this message
pm about · show about
pm + <pkg> · automatically install package or module (one at a time)
    -> +A · assume yes on first corresponding package manager
    -> +y · tell package manager to assume yes without confirmation
pm - <pkg> · automatically remove package or module (one at a time)
    -> -A · assume yes on first corresponding package manager
    -> -y · tell package manager to assume yes without confirmation
pm sysupdate · Update ArctineOS"
}

pm.add() {
    BackendArgs=()
    Args=$1

    export Args
    pm.backenddetector "${@:2}"
    pm.argumentassembly
    case "$Backend" in
        localpacman)
            sudo pacman -U "${BackendArgs[@]}" "${@:2}"
        ;;
        pacman)
            sudo pacman -S "${BackendArgs[@]}" "$(pacman -Ssq "$2" | gum filter --select-if-one --limit=1)"
        ;;
        flatpak|flatpakfile)
            flatpak install "${BackendArgs[@]}" "${@:2}"
        ;;
        arclimod)
            pm.arclimod "${@}"
        ;;
    esac
}

pm.remove() {
    BackendArgs=()
    Args=$1

    export Args
    pm.backenddetector "${@:2}"
    pm.argumentassembly
    case "$Backend" in
        localpacman|pacman)
            sudo pacman -R "${BackendArgs[@]}" "$(pacman -Qsq "$2" | gum filter --select-if-one --limit=1)"
        ;;
        flatpak|flatpakfile)
            flatpak uninstall "${BackendArgs[@]}" "${@:2}"
        ;;
        arclimod)
            pm.arclimod "${@}"
        ;;
    esac
}

pm.sysupdate() {
    # shellcheck disable=SC2164
    pushd /OS/arctine-pkg
        sudo gum spin --spinner points --title "Discarding any changes made..." -- git stash || pm.sysupdate.error "Failed to stash commits"
        sudo gum spin --spinner points --title "Pulling latest commit from OS source..." -- git pull || pm.sysupdate.error "Failed to pull"
        sudo gum spin --spinner points --title "Ensuring \"nobody:nobody\" owns ArctineOS source directory..." -- chown nobody:nobody -Rv . || pm.sysupdate.error "Failed to change ownership to nobody:nobody"
        source PKGBUILD || pm.sysupdate.error "Failed to source PKGBUILD"
        sudo pacman -Syu --noconfirm || pm.sysupdate.error "Failed to update all packages"
        # shellcheck disable=SC2154
        sudo pacman -S "${depends[@]}" --noconfirm || pm.sysupdate.error "Failed to install dependencies"
        sudo gum spin --spinner points --title "Building update..." -- sudo -u nobody makepkg -srf || pm.sysupdate.error "Failed to build update package"
        # shellcheck disable=SC2154
        sudo pacman -Uv ./"${pkgname}"-"${pkgver}"-"${pkgrel}"-"${arch[1]}".pkg.tar.zst --noconfirm || pm.sysupdate.error "Failed to install update"
        sudo chmod +x /Arctine/Tools/ArCLI/Modules/* || pm.sysupdate.error "Failed to add executable flag to ArCLI modules"
    # shellcheck disable=SC2164
    popd
}

pm.sysupdate.error() {
    echo "[!] System update failed with following message: $1"
    exit 1
}

pm.arclimod() {
    case "$Args" in
        +*)
            if [[ $Args == *y* ]]; then
                echo "[i] Installing ArCLI module $2..."
                # shellcheck disable=SC2154
                sudo cp "$2" "$ArCLI_DIR"/Modules/ -v || (echo "[!] Failed." && exit 1)
            else
                read -rp "[i] Install ArCLI module $2? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        sudo cp "$2" "$ArCLI_DIR"/Modules/ -v || (echo "[!] Failed." && exit 1)
                    ;;
                    *)
                        echo "[i] Aborted."
                        return 1
                    ;;
                esac
            fi
        ;;
        -*)
            echo "[i] Checking ownership..."
            if pacman -Qoq "$2"; then
                ownerPackage=$(pacman -Qoq "$2")
                read -rp "[?] $ownerPackage via pacman owns module $2. Remove $ownerPackage? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        sudo pacman -R "$ownerPackage" || (echo "[!] Failed." && exit 1)
                    ;;
                    *)
                        echo "[i] Aborted."
                        return 1
                    ;;
                esac
            else
                read -rp "[?] Really remove ArCLI module $2? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        sudo rm "$ArCLI_DIR"/Modules/"$2" -v || (echo "[!] Failed." && exit 1)
                    ;;
                    *)
                        echo "[i] Aborted."
                        return 1
                    ;;
                esac
            fi
        ;;
        *)
            echo "[!] Unrecognised option for pm.arclimod: $1"
            exit 1
        ;;
    esac
}

pm.backenddetector() {
    if [[ -z "$*" ]]; then
        echo "Please specify a package after pm $Args."
        exit 1
    elif [[ -z $Backend ]]; then
        # If file
        if [[ -f $1 ]]; then
            # If localpacman
            if echo "$1" | grep ".pkg.tar.zst$"; then
                GuessBackend=localpacman 
                pm.backenddetector.question && return 0
            else
                echo "[W] Local-pacman guess incorrect"
            fi

            # If flatpakref
            if (echo "$1" | grep ".flatpakref$") || (echo "$1" | grep ".flatpak$"); then
                GuessBackend=flatpakfile 
                pm.backenddetector.question && return 0
            else
                echo "[W] Flatpak (file) guess incorrect"
            fi

            # If ArCLIModule
            if echo "$1" | grep ".arclimod$"; then
                GuessBackend=arclimod 
                pm.backenddetector.question && return 0
            else
                echo "[W] ArCLI Module guess incorrect"
            fi
        fi

        # If not a file
        if pacman -Ssq "$1" | grep "$1">/dev/null; then
            GuessBackend=pacman 
            if pm.backenddetector.question; then 
                return 0
            else
                read -rp "[W] Attempt installation with Flatpak? [Y/n] " confirm
                case "$confirm" in
                    Y|y|yes|Yes|YES)
                        Backend=flatpak
                        export Backend
                    ;;
                    *)
                        echo "[!] User denied."
                        exit 1
                    ;;
                esac
            fi
        else
            read -rp "[W] pacman guess incorrect. Trying flatpak next, OK? [Y/n] " confirm
            case "$confirm" in
                Y|y|yes|Yes|YES)
                    Backend=flatpak
                    export Backend
                ;;
                *)
                    echo "[!] User denied."
                    exit 1
                ;;
            esac
        fi
    fi
}

pm.backenddetector.question() {
    if [[ $Args == *A* ]]; then
        echo "[i] Automatically selected $GuessBackend"
        Backend=$GuessBackend
        export Backend
    else
        echo "Detected backend: $GuessBackend"
        read -rp "Proceed? [Y/n] " confirm
        case "$confirm" in
            Y|y|yes|Yes|YES)
                Backend=$GuessBackend
                export Backend
                return 0
            ;;
            *)
                echo "[i] Continuing guess..."
                return 1
            ;;
        esac
    fi
}

pm.argumentassembly() {
    case "$Backend" in
        pacman|localpacman)
            [[ $Args == *y* ]] && BackendArgs+=(--noconfirm)
            echo "[i] Assembled pm arguments into $Backend ones: ${BackendArgs[*]}"
        ;;

        flatpak|flatpakfile)
            [[ $Args == *y* ]] && BackendArgs+=(--assumeyes)
            echo "[i] Assembled pm arguments into $Backend ones: ${BackendArgs[*]}"
        ;;
    esac
}

# Show info about software
about() {
    echo "$arclimod_Name ($arclimod_ShortDesc) $arclimod_Version
$arclimod_Author $arclimod_Year"
    echo "$arclimod_Desc"
}

main "$@"