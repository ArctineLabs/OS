[org.gnome.desktop.interface]
accent-color='purple'
font-name='IBM Plex Sans 11'
document-font-name='IBM Plex Serif 12'
monospace-font-name='IBM Plex Mono 11'

[org.gnome.shell]
enabled-extensions=['copyous@boerdereinar.dev', 'dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'gsconnect@andyholmes.github.io', 'ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'add-to-desktop@tommimon.github.com', 'blur-my-shell@aunetx', 'tilingshell@ferrarodomenico.com', 'lockscreen-extension@pratap.fastmail.fm']
always-show-log-out=true

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
